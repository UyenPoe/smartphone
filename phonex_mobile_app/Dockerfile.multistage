# ==============================================================================
# PhoneX Mobile App - Multi-stage Build Dockerfile
# Stage 1: Tải Flutter SDK và biên dịch mã nguồn sang Web
# Stage 2: Đóng gói sang Nginx Alpine siêu nhẹ phục vụ Production
# ==============================================================================

# --- Stage 1: Build Flutter Web ---
FROM ghcr.io/cirruslabs/flutter:stable AS builder

WORKDIR /app

# Tối ưu Docker layer cache bằng cách copy dependencies trước
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

# Copy toàn bộ mã nguồn app và biên dịch
COPY . .
RUN flutter build web --release --no-tree-shake-icons

# --- Stage 2: Production Nginx Server ---
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build/web /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
