# ==============================================================================
# PhoneX Website & Mobile Simulator - Dockerfile
# Base: Nginx Alpine
# Phục vụ: Website PhoneX, Kho máy, Trả góp & Trình giả lập Mobile Simulator
# ==============================================================================
FROM nginx:alpine

# Copy cấu hình Nginx
COPY nginx-web.conf /etc/nginx/conf.d/default.conf

# Copy toàn bộ tài nguyên web tĩnh, simulator, trang shop
WORKDIR /usr/share/nginx/html
COPY index.html mobile-preview.html dev-pages.html ./
COPY assets ./assets
COPY pages ./pages
COPY components ./components
COPY data ./data

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
